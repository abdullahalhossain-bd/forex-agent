# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Python virtual environments
# =========================
.venv/
venv/
env/

# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*.pyo

# =========================
# Local memory / runtime state
# =========================

# =========================
# Databases
# =========================
*.db
*.db*
*.sqlite
*.sqlite3

# =========================
# Model / binary artifacts
# =========================
*.bin
*.pkl
*.pickle
*.joblib
*.h5
*.onnx

# =========================
# Large historical / cache data (generic, do NOT touch data/historical)
# =========================
data/history/
data/cache/
data/pipeline_cache/

# =========================
# Large data files (only blocks files directly in data/, not subfolders)
# =========================
data/*.csv
data/*.parquet
data/*.feather

# =========================
# Explicitly allow data/historical CSV & JSON to be uploaded
# (negation rules — must come AFTER the block rules above)
# =========================
!data/historical/
!data/historical/**
!data/historical/*.csv
!data/historical/*.json

# =========================
# General generated files
# =========================
*.tmp